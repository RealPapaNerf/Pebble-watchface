{
  "name": "simply-digital",
  "author": "MrReSc",
  "description": "A monochrome seven-segment watchface for Pebble Time 2 with health and local sun times.",
  "version": "1.2.0",
  "license": "Apache-2.0",
  "keywords": [
    "pebble-app",
    "watchface",
    "health"
  ],
  "private": true,
  "dependencies": {},
  "pebble": {
    "displayName": "Simply Digital DA",
    "uuid": "5082efa7-02dc-4a67-a0c9-9e58a8108475",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery"
    ],
    "watchapp": {
      "watchface": true
    },
    "capabilities": [
      "health",
      "location"
    ],
    "messageKeys": [
      "JS_READY",
      "REQUEST_SUN",
      "SUNRISE_MINUTES",
      "SUNSET_MINUTES",
      "SUN_DATE",
      "NEXT_SUNRISE_MINUTES",
      "NEXT_SUN_DATE",
      "REQUEST_WEATHER",
      "DENSITY_ALTITUDE_FT",
      "PHONE_STATUS"
    ],
    "resources": {
      "media": [
        {
          "type": "bitmap",
          "name": "IMAGE_MENU_ICON",
          "file": "images/menu_icon.png",
          "menuIcon": true
        },
        {
          "type": "font",
          "name": "FONT_DIGITAL_72",
          "file": "fonts/DigitalNumbers-Regular.ttf",
          "characterRegex": "[0-9]"
        }
      ]
    }
  }
}
